  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Home",
        "meta_descr": "AuthorYogendra.com — Where Words Meet Wisdom\n\nWelcome to the official website of Author Yogendra Singh, an emerging voice in the world of literature, motivation, and deep human emotions. Explore his collection of thought-provoking stories, inspirational books, and powerful articles that blend love, life, philosophy, and realism.\n\nFrom motivational tales to bold psychological fiction, and from spiritual insights to practical legal knowledge, this platform reflects Yogendra Ji's diverse writing journey. Whether you're a seeker of inspiration, a story lover, or someone on a path of self-discovery — there’s something here for you.\n\n📚 Featured Genres:\n✔️ Motivational & Self-Help\n✔️ Love Stories & Novels\n✔️ Spiritual & Philosophical Writings\n✔️ Bold, Psychological Explorations\n✔️ Legal Awareness & Educational Content\n\nDive in, discover unique narratives, and join the community of readers who believe words can change lives.\n\nAuthorYogendra.com — Read. Reflect. Rise.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "z-index": "1000",
            "width": "100%",
            "position": "relative",
            ".dropdown-item:before": {
              "font-family": "Moririse2 !important",
              "content": "\"\\e966\"",
              "display": "inline-block",
              "width": "0",
              "position": "absolute",
              "left": "1rem",
              "top": "0.5rem",
              "margin-right": "0.5rem",
              "line-height": "1",
              "font-size": "inherit",
              "vertical-align": "middle",
              "text-align": "center",
              "overflow": "hidden",
              "transform": "scale(0, 1)",
              "transition": "all 0.25s ease-in-out"
            },
            "@media (max-width: 767px)": {
